{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenCart REST Affiliates Customer API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_token",
      "value": "{{api_token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customer",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Set customer for the current session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://yourstore.com/index.php?route=api/customer",
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Associates a customer with the current API session. Validates customer existence, group, name, email, telephone, and custom fields.\n"
        }
      ]
    }
  ],
  "bundled": true
}