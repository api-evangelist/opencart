      "item": [
        {
          "id": "be6f28d7-e3c2-4e9c-ba0d-281a089e2d08",
          "name": "Authenticate and obtain API session token",
          "request": {
            "name": "Authenticate and obtain API session token",
            "description": {
              "content": "Submits API username and key credentials to authenticate. Returns a session api_token that must be passed as a query parameter or POST field on all subsequent requests. The calling IP address must be in the store's API IP allowlist.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "(Required) API username configured in Admin > System > Users > API"
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) API key (64-character alphanumeric secret)"
                }
              ]
            }
          },
          "response": [
            {
              "id": "3673c4af-a98d-481c-b8db-3f7f1a673a12",
              "name": "Successful authentication",
